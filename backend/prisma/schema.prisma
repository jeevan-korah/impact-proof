generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  engineer
  company
}

enum Vertical {
  frontend
  backend
  ml
}

enum Difficulty {
  easy
  medium
  hard
}

enum ChallengeSource {
  company
  opensource
}

enum ChallengeStatus {
  open
  closed
}

enum ProposalStatus {
  pending
  shortlisted
  rejected
}

enum SubmissionStatus {
  pending
  completed
  flagged
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role
  githubUrl     String?
  createdAt     DateTime @default(now())

  // Relations
  challenges    Challenge[]     @relation("CompanyChallenges")
  proposals     Proposal[]
  submissions   Submission[]
  profile       EngineerProfile?
  impactRecords ImpactRecord[]
}

model Challenge {
  id                 String          @id @default(uuid())
  postedById         String?
  title              String
  description        String
  vertical           Vertical
  difficulty         Difficulty
  source             ChallengeSource
  baselineValue      Float
  targetValue        Float
  comparisonOperator String
  constraints        Json?
  checklist          Json            // ✅ moved here — string[] set by company
  threshold          Float           @default(70) // ✅ moved here — set by company
  repoUrl            String?
  issueUrl           String?
  status             ChallengeStatus @default(open)
  createdAt          DateTime        @default(now())

  // Relations
  postedBy      User?          @relation("CompanyChallenges", fields: [postedById], references: [id])
  proposals     Proposal[]
  submissions   Submission[]
  impactRecords ImpactRecord[]
}

model Proposal {
  id           String         @id @default(uuid())
  
  challengeId  String
  engineerId   String
  proposalText String         // ✅ engineer just writes this
  evaluation   Json?          // ✅ stored result from Ollama
  ticked       Int?
  total        Int?
  percentage   Float?
  decision     String?        // "APPROVED" or "REJECTED"
  reason       String?
  status       ProposalStatus @default(pending)
  createdAt    DateTime       @default(now())

  // Relations
  challenge  Challenge   @relation(fields: [challengeId], references: [id])
  engineer   User        @relation(fields: [engineerId], references: [id])
  submission Submission?

  @@unique([challengeId, engineerId])
}

model Submission {
  id                String           @id @default(uuid())
  proposalId        String           @unique
  challengeId       String
  engineerId        String
  repoUrl           String
  achievedValue     Float?
  improvementDelta  Float?
  constraintsPassed Boolean?
  passed            Boolean?
  codeFingerprint   String?
  similarityScore   Float?
  integrityFlag     Boolean          @default(false)
  status            SubmissionStatus @default(pending)
  createdAt         DateTime         @default(now())

  // Relations
  proposal     Proposal     @relation(fields: [proposalId], references: [id])
  challenge    Challenge    @relation(fields: [challengeId], references: [id])
  engineer     User         @relation(fields: [engineerId], references: [id])
  impactRecord ImpactRecord?
}

model EngineerProfile {
  engineerId       String   @id
  totalSubmissions Int      @default(0)
  totalPassed      Int      @default(0)
  avgImprovement   Float    @default(0)
  kpiScore         Float    @default(0)
  updatedAt        DateTime @default(now())

  // Relation
  engineer User @relation(fields: [engineerId], references: [id])
}

model ImpactRecord {
  id               String   @id @default(uuid())
  engineerId       String
  challengeId      String
  submissionId     String   @unique
  baselineValue    Float
  achievedValue    Float
  improvementDelta Float
  passed           Boolean
  integrityFlag    Boolean  @default(false)
  recordedAt       DateTime @default(now())

  // Relations
  engineer   User       @relation(fields: [engineerId], references: [id])
  challenge  Challenge  @relation(fields: [challengeId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])
}



